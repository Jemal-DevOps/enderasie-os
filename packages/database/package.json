{
  "name": "@enderasie/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
   "scripts": {
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "seed:ops": "tsx --env-file=../../.env src/seed-ops.ts",
    "seed:enterprise": "tsx --env-file=../../.env src/seed-enterprise.ts",
    "seed:enterprise": "tsx --env-file=../../.env src/seed-enterprise.ts && tsx --env-file=../../.env src/seed-finance.ts",
    "seed:ops:data": "tsx --env-file=../../.env src/seed-ops-data.ts",
    "seed:enterprise": "tsx --env-file=../../.env src/seed-enterprise.ts && tsx --env-file=../../.env src/seed-finance.ts && tsx --env-file=../../.env src/seed-subcontracts.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
  
}
